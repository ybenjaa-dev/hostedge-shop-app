{
  "name": "hostedge-shop-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:generate": "drizzle-kit generate && npm run gen:migrations",
    "db:migrate:local": "wrangler d1 migrations apply main --local",
    "seed": "tsx scripts/seed.ts",
    "gen:migrations": "node scripts/gen-migrations.mjs",
    "predev": "node scripts/apply-theme.mjs && npm run gen:migrations",
    "prebuild": "node scripts/apply-theme.mjs && npm run gen:migrations",
    "precf:build": "node scripts/apply-theme.mjs && npm run gen:migrations",
    "prepreview": "node scripts/apply-theme.mjs && npm run gen:migrations",
    "predeploy": "node scripts/apply-theme.mjs && npm run gen:migrations",
    "theme": "node scripts/apply-theme.mjs",
    "theme:reset": "node scripts/apply-theme.mjs --reset",
    "theme:verify": "node scripts/verify-themes.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
